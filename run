#!/bin/sh
# ./run dev <devkit args>          build, relaunch, capture, checks, verify (./run dev --help)
# ./run release <release-kit args> version, bundle, sign, appcast, check, publish
# ./run lint [dyl-lint args]
# ./run format [--check]           swift-format with .swift-format
# ./run ui [ui-screenshots args]   iPhone and iPad simulator screenshots with fixture books
# ./run bootstrap                  write Config.xcconfig (dev Contentful credentials) from 1Password
set -eu
root=$(cd "$(dirname "$0")" && pwd)

# DylKit lives in scone-os until github.com/dgattey/dyl-kit exists (see Package.swift).
dylkit() {
    [ -n "${DYLKIT_PATH:-}" ] && return
    checkout="$root/.dylkit/scone-os"
    if [ ! -d "$checkout/.git" ]; then
        git clone -q --depth 1 https://github.com/dgattey/scone-os "$checkout" >&2
    fi
}

case "${1:-}" in
dev) tool=devkit ;;
release) tool=release-kit ;;
lint) tool=dyl-lint ;;
format)
    shift
    if [ "${1:-}" = "--check" ]; then
        exec swift format lint --strict --recursive --parallel "$root/Sources" "$root/Tests" "$root/Package.swift"
    fi
    exec swift format --in-place --recursive --parallel "$root/Sources" "$root/Tests" "$root/Package.swift"
    ;;
ui)
    shift
    dylkit
    exec "$root/scripts/ui-screenshots.sh" "$@"
    ;;
bootstrap)
    exec "$root/scripts/bootstrap.sh"
    ;;
*)
    sed -n '2,7p' "$0" | sed 's/^# //' >&2
    exit 2
    ;;
esac
shift
dylkit
swift build --package-path "$root" -c release --product "$tool" -q >&2
export DYLKIT_ROOT="$root"
exec "$root/.build/release/$tool" "$@"
