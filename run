#!/usr/bin/env bash
set -euo pipefail

#
# run - Lightweight wrapper for Swift scripts
#
# Discovers and runs Swift scripts from scripts/Sources/. Each script is a
# directory containing main.swift. Descriptions are extracted from a
# "// DESCRIPTION: ..." comment at the top of each main.swift.
#
# Usage:
#   run <script> [args...]    Run a script
#   run --help                List available scripts
#   run --completions         Output script names (for shell completion)
#
# Examples:
#   run bootstrap
#   run checks
#   run version-and-release read
#

ROOT="$(cd "$(dirname "$0")" && pwd)"
SOURCES="$ROOT/scripts/Sources"

# List all script names (directories under Sources/, excluding Common)
scripts() {
    for dir in "$SOURCES"/*/; do
        local name="${dir%/}"
        name="${name##*/}"
        [[ "$name" != "Common" ]] && echo "$name"
    done
}

# Get description from "// DESCRIPTION: ..." in main.swift
description() {
    local file="$SOURCES/$1/main.swift"
    [[ -f "$file" ]] || return 0
    local line
    while IFS= read -r line; do
        if [[ "$line" == "// DESCRIPTION:"* ]]; then
            line="${line#// DESCRIPTION:}"
            echo "${line#"${line%%[![:space:]]*}"}"
            return 0
        fi
    done < "$file"
}

# Handle --completions (for shell tab completion)
if [[ "${1:-}" == "--completions" ]]; then
    scripts
    exit 0
fi

# Handle --help or no arguments
if [[ $# -lt 1 || "$1" == "-h" || "$1" == "--help" ]]; then
    echo "Usage: run <script> [args...]"
    echo
    echo "Available scripts:"
    for script in $(scripts); do
        printf "  %-24s %s\n" "$script" "$(description "$script")"
    done
    exit 0
fi

SCRIPT="$1"
shift

if [[ ! -d "$SOURCES/$SCRIPT" || "$SCRIPT" == "Common" ]]; then
    echo "Unknown script: $SCRIPT" >&2
    echo "Run 'run --help' to list available scripts." >&2
    exit 1
fi

BIN="$ROOT/scripts/.build/debug/$SCRIPT"

# Rebuild only when the binary is missing or older than Package.swift / script sources
if [[ ! -x "$BIN" ]] || [[ "$ROOT/scripts/Package.swift" -nt "$BIN" ]] \
    || [[ -n "$(find -L "$SOURCES/Common" "$SOURCES/$SCRIPT" -newer "$BIN" -print -quit 2>/dev/null)" ]]; then
    swift build -q --package-path "$ROOT/scripts" --product "$SCRIPT"
    touch -c "$BIN"
fi

exec "$BIN" "$@"
